{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/davidru/KB-Creation-Framework/model-registry.schema.json",
  "title": "KB Creation Framework v3.1 Model Registry",
  "description": "Validates operator model registry entries. Operators may extend the family/provider enums in this schema when adding supported families or providers.",
  "type": "object",
  "additionalProperties": true,
  "required": ["models"],
  "properties": {
    "version": {
      "type": ["integer", "string"]
    },
    "recommended_assignment": {
      "type": "object",
      "additionalProperties": true
    },
    "notes": {
      "type": "string"
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/modelRegistryEntry"
      }
    }
  },
  "$defs": {
    "modelRegistryEntry": {
      "type": "object",
      "additionalProperties": true,
      "required": ["handle", "family", "provider", "model_id"],
      "properties": {
        "handle": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "family": {
          "type": "string",
          "enum": ["anthropic", "openai", "google", "meta-llama", "mistral", "deepseek", "internal-microsoft", "other"]
        },
        "provider": {
          "type": "string",
          "enum": ["copilot-cli", "azure-foundry", "openrouter", "ollama"]
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "endpoint": {
          "type": "string",
          "pattern": "^env:[A-Za-z_][A-Za-z0-9_]*$"
        },
        "api_key": {
          "type": "string",
          "pattern": "^env:[A-Za-z_][A-Za-z0-9_]*$"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
